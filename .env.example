API_ID=
API_HASH=
CHANNEL_ID=-100xxxxxxxxxx
SESSION_STRING=

# Credenciales de la web (la contraseña debe tener 10+ caracteres).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_USER=elige_un_usuario
ADMIN_PASS=

# Opcionales
# DATA_DIR=data          # catalog.db y miniaturas (usa un disco persistente en el hosting)
# FULL_SYNC=1            # releer todo el canal al arrancar (detecta ediciones y borrados)
# ITEMS_PER_PAGE=12
# AUTO_META=1            # rellena sinopsis/año/género/portada que falten (Jikan, Open Library y TMDB)
# TMDB_API_KEY=          # opcional: mejora películas, series y documentales (themoviedb.org, gratis)
# AUTO_BACKUP=1          # guarda favoritos/vistos/progreso en «Mensajes guardados» de Telegram y los recupera solo (útil sin disco persistente)
